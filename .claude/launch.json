{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spectral-drift",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "games/spectral-drift", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "echo-hollow",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "games/echo-hollow", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "arcade",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "preview", "--outDir", "dist", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "arcade-subpath",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "preview", "--outDir", "dist", "--base", "/arcade/", "--port", "4174", "--strictPort"],
      "port": 4174
    },
    {
      "name": "arcade-serve-local",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/serve.mjs", "--host", "127.0.0.1", "--port", "8080"],
      "port": 8080
    }
  ]
}
